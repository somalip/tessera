#!/bin/bash
set -eu
arguments=()
while (( $# )); do
  case "$1" in
    --n-gpu-layers) arguments+=(--n-gpu-layers 99); shift 2 ;;
    --device) shift 2 ;;
    *) arguments+=("$1"); shift ;;
  esac
done
if [[ ${TINY_STRENGTH_REASONING_BUDGET:-0} != 0 ]]; then
  arguments+=(--reasoning-budget "$TINY_STRENGTH_REASONING_BUDGET" --reasoning-format deepseek)
fi
exec "$(dirname "$0")/../python-v2/llama-b12244/llama-server" "${arguments[@]}"
