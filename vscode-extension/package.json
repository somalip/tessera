{
  "name": "tinycoders",
  "displayName": "TinyCoders",
  "version": "0.1.0",
  "publisher": "tinycoders",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "scripts": {
    "check": "eslint src && tsc --noEmit",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "2.5.2",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:python"
  ],
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "TinyCoders",
      "properties": {
        "tinycoders.serverPath": {
          "type": "string",
          "scope": "machine",
          "default": "llama-server",
          "description": "Path to the local llama.cpp server executable."
        },
        "tinycoders.pythonModelPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to a local Qwen2.5-Coder GGUF for Python FIM."
        },
        "tinycoders.gpuLayers": {
          "type": "integer",
          "minimum": 0,
          "scope": "machine",
          "default": 0,
          "description": "Number of model layers to offload to the GPU."
        }
      }
    }
  }
}
