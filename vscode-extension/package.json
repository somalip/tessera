{
  "name": "tinycoders",
  "displayName": "TinyCoders",
  "version": "0.1.0",
  "publisher": "tinycoders",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "scripts": {
    "check": "eslint src && tsc --noEmit",
    "build": "tsc",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --skip-license --out ../artifacts/tinycoders.vsix"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/vscode": "1.96.0",
    "@types/yauzl": "2.10.3",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.1.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "ajv": "8.20.0",
    "yauzl": "3.4.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "TinyCoders",
      "properties": {
        "tinycoders.serverPath": {
          "type": "string",
          "scope": "machine",
          "default": "llama-server",
          "description": "Path to the local llama.cpp server executable."
        },
        "tinycoders.pythonModelPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to a local Qwen2.5-Coder GGUF for Python FIM."
        },
        "tinycoders.gpuLayers": {
          "type": "integer",
          "minimum": 0,
          "scope": "machine",
          "default": 0,
          "description": "Number of model layers to offload to the GPU."
        },
        "tinycoders.typescriptModelPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to a local Qwen2.5-Coder GGUF for TypeScript FIM."
        },
        "tinycoders.generalist": {
          "type": "string",
          "default": "",
          "description": "Model ID to use as a last resort."
        },
        "tinycoders.memoryMiB": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Estimated model memory budget in MiB. Zero uses 60% of free RAM."
        },
        "tinycoders.maxModels": {
          "type": "integer",
          "minimum": 1,
          "default": 2,
          "description": "Maximum number of resident models."
        },
        "tinycoders.idleMinutes": {
          "type": "number",
          "minimum": 0.01,
          "default": 5,
          "description": "Minutes before an idle model is unloaded."
        },
        "tinycoders.registryUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "HTTPS URL of the signed TinyCoders registry JSON."
        },
        "tinycoders.registryPublicKey": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "PEM-encoded trusted Ed25519 public key for the registry."
        },
        "tinycoders.repositoryContext": {
          "type": "boolean",
          "default": true,
          "description": "Include nearby workspace snippets and local language service definitions in inline completions."
        }
      }
    },
    "commands": [
      {
        "command": "tinycoders.pickModel",
        "title": "TinyCoders: Pick Model"
      },
      {
        "command": "tinycoders.installModel",
        "title": "TinyCoders: Install Model"
      },
      {
        "command": "tinycoders.switchVersion",
        "title": "TinyCoders: Switch Installed Model Version"
      },
      {
        "command": "tinycoders.explain",
        "title": "TinyCoders: Explain Code"
      },
      {
        "command": "tinycoders.refactor",
        "title": "TinyCoders: Refactor Code"
      },
      {
        "command": "tinycoders.writeTests",
        "title": "TinyCoders: Write Tests"
      },
      {
        "command": "tinycoders.exportMetrics",
        "title": "TinyCoders: Export Local Metrics"
      }
    ],
    "chatParticipants": [
      {
        "id": "tinycoders.local",
        "name": "tinycoders",
        "fullName": "TinyCoders",
        "description": "Chat with the active local TinyCoders model"
      }
    ]
  },
  "description": "Local per-language GGUF routing, inline completion, and chat.",
  "repository": {
    "type": "git",
    "url": "https://github.com/somalip/tessera.git",
    "directory": "vscode-extension"
  },
  "extensionKind": [
    "ui"
  ]
}
