{
  "name": "tinycoders",
  "displayName": "TinyCoders",
  "version": "0.1.5",
  "publisher": "tinycoders",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "scripts": {
    "check": "eslint src && tsc --noEmit",
    "build": "tsc",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --skip-license --out ../artifacts/tinycoders.vsix"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/vscode": "1.96.0",
    "@types/yauzl": "2.10.3",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.1.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "ajv": "8.20.0",
    "yauzl": "3.4.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "TinyCoders",
      "properties": {
        "tinycoders.serverPath": {
          "type": "string",
          "scope": "machine",
          "default": "llama-server",
          "description": "Path to the local llama.cpp server executable."
        },
        "tinycoders.pythonAutocompleteModelPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to the small Python autocomplete GGUF. Preferred for inline suggestions."
        },
        "tinycoders.parsingAutocompleteModelPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to the local Qwen2.5-Coder GGUF for structured data, regex, and SQL autocomplete."
        },
        "tinycoders.documentationAutocompleteModelPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to the local Qwen3.5 documentation GGUF for prose and Python docstring autocomplete."
        },
        "tinycoders.pythonModelPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to a local Qwen2.5-Coder GGUF for Python FIM."
        },
        "tinycoders.cpuThreads": {
          "type": "integer",
          "minimum": 0,
          "scope": "machine",
          "default": 0,
          "description": "Maximum inference and prompt-processing threads per model server. Zero uses llama.cpp defaults."
        },
        "tinycoders.gpuLayers": {
          "type": "integer",
          "minimum": 0,
          "scope": "machine",
          "default": 0,
          "description": "Number of model layers to offload to the GPU per server. Zero runs inference on the CPU."
        },
        "tinycoders.typescriptModelPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to a local Qwen2.5-Coder GGUF for TypeScript FIM."
        },
        "tinycoders.generalist": {
          "type": "string",
          "default": "",
          "description": "Model ID to use as a last resort."
        },
        "tinycoders.memoryMiB": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Estimated model memory limit in MiB. Zero uses 60% of free RAM as a target and allows one disk-backed CPU model to exceed it."
        },
        "tinycoders.autocomplete": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": true,
          "description": "Show TinyCoders inline suggestions automatically as you type."
        },
        "tinycoders.commentCompletions": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": true,
          "description": "Let a Python comment or a tinycoders: comment in other languages trigger a suggestion on the next blank line when automatic suggestions are off."
        },
        "tinycoders.maxModels": {
          "type": "integer",
          "minimum": 1,
          "default": 2,
          "description": "Maximum number of resident models."
        },
        "tinycoders.idleMinutes": {
          "type": "number",
          "minimum": 0.01,
          "default": 5,
          "description": "Minutes before an idle model is unloaded."
        },
        "tinycoders.registryUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "HTTPS URL of the signed TinyCoders registry JSON."
        },
        "tinycoders.registryPublicKey": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "PEM-encoded trusted Ed25519 public key for the registry."
        },
        "tinycoders.repositoryContext": {
          "type": "boolean",
          "default": true,
          "description": "Include nearby workspace snippets and local language service definitions in inline completions."
        }
      }
    },
    "commands": [
      {
        "command": "tinycoders.pickModel",
        "title": "TinyCoders: Pick Model"
      },
      {
        "command": "tinycoders.installModel",
        "title": "TinyCoders: Install Model"
      },
      {
        "command": "tinycoders.switchVersion",
        "title": "TinyCoders: Switch Installed Model Version"
      },
      {
        "command": "tinycoders.explain",
        "title": "TinyCoders: Explain Code"
      },
      {
        "command": "tinycoders.refactor",
        "title": "TinyCoders: Refactor Code"
      },
      {
        "command": "tinycoders.writeTests",
        "title": "TinyCoders: Write Tests"
      },
      {
        "command": "tinycoders.exportMetrics",
        "title": "TinyCoders: Export Local Metrics"
      },
      {
        "command": "tinycoders.resourceLimits",
        "title": "TinyCoders: Resource Limits"
      },
      {
        "command": "tinycoders.openDashboard",
        "title": "TinyCoders: Open Dashboard"
      },
      {
        "command": "tinycoders.addLocalModel",
        "title": "TinyCoders: Add Local GGUF",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "tinycoders.ask",
        "title": "TinyCoders: Ask",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "tinycoders.triggerCompletion",
        "title": "TinyCoders: Trigger Inline Completion",
        "enablement": "isWorkspaceTrusted && editorIsOpen"
      },
      {
        "command": "tinycoders.openChat",
        "title": "TinyCoders: Open Chat"
      },
      {
        "command": "tinycoders.showOutput",
        "title": "TinyCoders: Show Output"
      }
    ],
    "chatParticipants": [
      {
        "id": "tinycoders.local",
        "name": "tinycoders",
        "fullName": "TinyCoders",
        "description": "Chat with the active local TinyCoders model"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tinycoders",
          "title": "TinyCoders",
          "icon": "$(chip)"
        }
      ]
    },
    "views": {
      "tinycoders": [
        {
          "id": "tinycoders.dashboard",
          "type": "webview",
          "name": "Dashboard",
          "icon": "$(chip)"
        }
      ]
    }
  },
  "description": "Local per-language GGUF routing, inline completion, and chat.",
  "repository": {
    "type": "git",
    "url": "https://github.com/somalip/tessera.git",
    "directory": "vscode-extension"
  },
  "extensionKind": [
    "ui"
  ]
}
